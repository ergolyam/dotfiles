{
    "label" : "lock",
    "action" : "swaylock -f",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "loginctl hibernate",
    "text" : "Hibernation",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "pkill -u $USER",
    "text" : "Exit",
    "keybind" : "e"
}
{
    "label" : "shutdown",
{{ if eq .init "systemd" }}
    "action" : "systemctl poweroff",
{{ else }}
    "action" : "loginctl poweroff",
{{ end }}
    "text" : "PowerOff",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "loginctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
{{ if eq .init "systemd" }}
    "action" : "systemctl reboot",
{{ else }}
    "action" : "loginctl reboot",
{{ end }}
    "text" : "Reboot",
    "keybind" : "r"
}
