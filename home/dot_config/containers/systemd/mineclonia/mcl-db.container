[Unit]
PartOf=mineclonia.target

[Container]
UserNS=keep-id:uid=70,gid=70

Environment=PGDATA=/data
EnvironmentFile=%E/containers/systemd/mineclonia/mcl.env

Image=docker.io/postgres:17-alpine
AutoUpdate=registry

Network=mineclonia.network
NetworkAlias=db

Volume=%h/data/mcl-db:/data

HealthCmd=pg_isready
HealthInterval=2s
Notify=healthy

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/data/mcl-db

